# --- Environment Configuration ---
ENVIRONMENT="development"
PORT=8000

# --- Database Configuration ---
# For local development
DATABASE_URL="postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost/pravaah_db"
# For Render deployment, this will be automatically provided as DATABASE_URL

# --- Security Configuration ---
SECRET_KEY="a_very_secret_key_change_me_generate_a_secure_one"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- External Services ---
# RabbitMQ (Optional - can be disabled for basic deployment)
RABBITMQ_URL="amqp://guest:guest@localhost/"

# AWS S3 Configuration (Required for file uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION=""

# Weather API Key
WEATHERAPI_KEY=""

# AI/LLM Configuration
GEMINI_API_KEY=""

# --- URL Configuration ---
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# --- Firebase Configuration ---
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"